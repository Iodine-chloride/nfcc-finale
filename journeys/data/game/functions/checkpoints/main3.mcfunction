execute as @a[gamemode=adventure] at @s if score @e[tag=checkpoint,distance=..1.5,limit=1,scores={journey_level=1..9}] journey_level = @s journey_level run title @s title [{"text":"+20 ","color":"green"},{"text":"⭐","color":"yellow"}]
execute as @a[gamemode=adventure] at @s if score @e[tag=checkpoint,distance=..1.5,limit=1,scores={journey_level=1..9}] journey_level = @s journey_level run scoreboard players add @s round_score_mb 20
