execute as @a[gamemode=adventure] at @s if score @e[tag=checkpoint,distance=..1.5,limit=1,scores={journey_level=1}] journey_level = @s journey_level run title @s title ["-[ ",{"text":"Chapter I","color":"gold"}," ]-"]
